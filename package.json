{
  "name": "boreal-snow-forest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "review": "vite build --mode review --outDir dist-review && node tests/review.mjs",
    "test:production": "node tests/production-smoke.mjs",
    "prepare:firs": "node scripts/download-firs.mjs && node --max-old-space-size=6144 scripts/prepare-firs.mjs",
    "test:snowfall": "node tests/snowfall-render.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "meshoptimizer": "^1.3.0",
    "vite": "^8.3.4"
  }
}
